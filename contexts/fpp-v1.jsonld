{
    "@context": {
        "@protected": true,
        "AgentNameCredential": "https://peacekeeper.github.io/dtgwg-cred-tf/contexts/fpp-v1.jsonld#AgentNameCredential",
        "agentName": "https://peacekeeper.github.io/dtgwg-cred-tf/contexts/fpp-v1.jsonld#agentName",
        "RelationshipCredential": {
            "@id": "https://firstperson.network/credentials/relationship/v1#RelationshipCredential",
            "@context": {
                "@protected": true,
                "id": "@id",
                "type": "@type"
            }
        },
        "from": {
            "@id": "https://firstperson.network/credentials/relationship/v1#from",
            "@type": "@id",
            "@context": {
                "did": "https://firstperson.network/credentials/relationship/v1#did",
                "name": "https://firstperson.network/credentials/relationship/v1#name"
            }
        },
        "to": {
            "@id": "https://firstperson.network/credentials/relationship/v1#to",
            "@type": "@id",
            "@context": {
                "did": "https://firstperson.network/credentials/relationship/v1#did",
                "name": "https://firstperson.network/credentials/relationship/v1#name"
            }
        },
        "relationshipType": "https://firstperson.network/credentials/relationship/v1#relationshipType",
        "startDate": "https://firstperson.network/credentials/relationship/v1#startDate",
        "endDate": "https://firstperson.network/credentials/relationship/v1#endDate"
    }
}
